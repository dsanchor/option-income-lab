# ── Python API container (FastAPI + scheduler) ───────────────────────────────

# Run as a JSON-only API (HTML pages return 404). Set to 1 in the api container.
# Leave unset/0 to run the legacy monolith (HTML + API).
API_ONLY=1

# ── Cosmos DB (required) ──────────────────────────────────────────────────────
COSMOSDB_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOSDB_KEY=your-primary-key

# ── AI provider (required): "azure" or "gemini" ──────────────────────────────
AI_PROVIDER=azure

# Azure OpenAI (when AI_PROVIDER=azure)
AZURE_AI_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
MODEL_DEPLOYMENT=gpt-5.1

# Google Gemini (when AI_PROVIDER=gemini)
GOOGLE_API_KEY=your-google-api-key

# ── Telegram notifications (optional) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
