# ── Python API container (FastAPI + scheduler) ───────────────────────────────

# ── Cosmos DB (required) ──────────────────────────────────────────────────────
COSMOSDB_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOSDB_KEY=your-primary-key

# ── AI provider (required): "azure" or "gemini" ──────────────────────────────
AI_PROVIDER=azure

# Azure OpenAI (when AI_PROVIDER=azure)
AZURE_AI_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
MODEL_DEPLOYMENT=gpt-5.1

# Google Gemini (when AI_PROVIDER=gemini)
GOOGLE_API_KEY=your-google-api-key

# ── Telegram notifications (optional) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Automatic user-data backup (local examples only) ─────────────────────────
# Production values are set on the Azure Container Apps Job by
# scripts/configure-backup.sh. They are not read from config.yaml or editable
# in Settings. These examples support local CLI execution and documentation.
# Storage access uses managed identity; do not set a Storage key/SAS.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
BACKUP_ENABLED=true
BACKUP_BLOB_CONTAINER=user-data-backups
BACKUP_TIMEZONE=Europe/Madrid
BACKUP_LOCAL_TIME=00:15
BACKUP_SCHEDULE_NAME=daily-user-data
BACKUP_BUILD_COMMIT=
BACKUP_MAX_ARCHIVE_BYTES=52428800
BACKUP_MAX_UNCOMPRESSED_BYTES=209715200
BACKUP_MAX_ENTRY_BYTES=52428800
BACKUP_MAX_ZIP_FILES=9
BACKUP_MAX_RECORDS=200000
BACKUP_MAX_JSON_DEPTH=30
BACKUP_MAX_EXPANSION_RATIO=100
