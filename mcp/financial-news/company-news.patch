+async function fetchFromFinnhub(query: string, limit: number, config: any, symbol?: string): Promise<NewsArticle[]> {
+  const now = Date.now();
+  const from = now - 7 * 24 * 60 * 60 * 1000;
+  const stopWords = new Set("a an and are as at by for from in is it of on or the to why stock today up down corporation company news".split(" "));
+  const keywords = [...new Set((query.toLowerCase().match(/[a-z0-9]+/g) || [])
+    .filter(word => word.length > 1 && !stopWords.has(word) && !/^\d+$/.test(word)))];
+  if (!symbol && keywords.length === 0) {
+    throw new NewsInputError("Provide meaningful general-topic keywords or an explicit public symbol.");
+  }
+  const response = await axios.get(`${config.baseUrl}/${symbol ? "company-news" : "news"}`, {
+    params: symbol ? {
+      symbol, from: new Date(from).toISOString().slice(0, 10),
+      to: new Date(now).toISOString().slice(0, 10), token: config.apiKey
+    } : { category: 'general', token: config.apiKey },
+    timeout: Math.min(config.timeout, 8000)
   });
+  if (!Array.isArray(response.data)) {
+    throw new Error("Invalid provider response");
+  }

