{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dsanchor/option-income-lab/infra/azure/provision-config.schema.json",
  "title": "Option Income Lab Azure provisioner configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "subscriptionId", "tenantId", "location", "resourceGroupName", "suffix", "names", "tags", "images", "models", "cosmos", "apps", "backup", "frontendAuth", "optionalSecrets", "diagnostics", "locks", "providers"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "subscriptionId": {"type": "string", "format": "uuid"},
    "tenantId": {"type": "string", "format": "uuid"},
    "location": {"type": "string", "pattern": "^[a-z0-9]+$"},
    "resourceGroupName": {"type": "string", "pattern": "^[A-Za-z0-9._()\\-]{1,90}$"},
    "suffix": {"type": "string", "pattern": "^[a-z0-9]{4,12}$"},
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logAnalytics", "containerAppsEnvironment", "apiApp", "frontendApp", "cosmosAccount", "foundryAccount", "foundryProject", "backupStorage", "backupContainer", "backupIdentity", "backupJob"],
      "properties": {
        "logAnalytics": {"$ref": "#/$defs/azureName"},
        "containerAppsEnvironment": {"$ref": "#/$defs/azureName"},
        "apiApp": {"$ref": "#/$defs/containerAppName"},
        "frontendApp": {"$ref": "#/$defs/containerAppName"},
        "cosmosAccount": {"type": "string", "pattern": "^[a-z0-9-]{3,44}$"},
        "foundryAccount": {"type": "string", "pattern": "^[a-zA-Z0-9-]{2,64}$"},
        "foundryProject": {"$ref": "#/$defs/azureName"},
        "backupStorage": {"type": "string", "pattern": "^[a-z0-9]{3,24}$"},
        "backupContainer": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{1,61}[a-z0-9])?$"},
        "backupIdentity": {"$ref": "#/$defs/azureName"},
        "backupJob": {"$ref": "#/$defs/containerAppName"}
      }
    },
    "tags": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^(?!.*(?:secret|password|token|api[Kk]ey|connection[Ss]tring)).+$"},
      "additionalProperties": {"type": "string", "maxLength": 256}
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "frontend"],
      "properties": {
        "api": {"$ref": "#/$defs/immutableGhcrImage"},
        "frontend": {"$ref": "#/$defs/immutableGhcrImage"}
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployments", "routing"],
      "properties": {
        "deployments": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"$ref": "#/$defs/modelMini"},
            {"$ref": "#/$defs/modelLuna"},
            {"$ref": "#/$defs/modelSol"}
          ],
          "items": false
        },
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "roles"],
          "properties": {
            "default": {"$ref": "#/$defs/deploymentName"},
            "roles": {
              "type": "object",
              "additionalProperties": false,
              "required": ["monitor_assessment", "monitor_roll", "analysis", "buy_tracker", "supervisor", "alpha", "summary", "report", "technical_analysis", "plan_monitor", "chat", "symbol_chat", "activity_chat", "dps_insights"],
              "properties": {
                "monitor_assessment": {"const": "gpt-5.6-luna"},
                "monitor_roll": {"const": "gpt-5.6-luna"},
                "analysis": {"const": "gpt-5.6-luna"},
                "buy_tracker": {"$ref": "#/$defs/deploymentName"},
                "supervisor": {"$ref": "#/$defs/deploymentName"},
                "alpha": {"$ref": "#/$defs/deploymentName"},
                "summary": {"$ref": "#/$defs/deploymentName"},
                "report": {"$ref": "#/$defs/deploymentName"},
                "technical_analysis": {"$ref": "#/$defs/deploymentName"},
                "plan_monitor": {"$ref": "#/$defs/deploymentName"},
                "chat": {"$ref": "#/$defs/deploymentName"},
                "symbol_chat": {"$ref": "#/$defs/deploymentName"},
                "activity_chat": {"$ref": "#/$defs/deploymentName"},
                "dps_insights": {"$ref": "#/$defs/deploymentName"}
              }
            }
          }
        }
      }
    },
    "cosmos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databaseName", "containers"],
      "properties": {
        "databaseName": {"type": "string", "minLength": 1},
        "containers": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            {"$ref": "#/$defs/containerSymbols"},
            {"$ref": "#/$defs/containerTelemetry"},
            {"$ref": "#/$defs/containerSettings"},
            {"$ref": "#/$defs/containerDgi"},
            {"$ref": "#/$defs/containerCalendar"},
            {"$ref": "#/$defs/containerTraces"},
            {"$ref": "#/$defs/containerPortfolio"},
            {"$ref": "#/$defs/containerImports"}
          ],
          "items": false
        }
      }
    },
    "apps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "frontend"],
      "properties": {
        "api": {"$ref": "#/$defs/app"},
        "frontend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetPort", "minReplicas", "maxReplicas", "cpu", "memory"],
          "properties": {
            "targetPort": {"const": 3000},
            "minReplicas": {"type": "integer", "minimum": 1},
            "maxReplicas": {"type": "integer", "minimum": 1},
            "cpu": {"type": "number", "minimum": 0.25},
            "memory": {"type": "string", "pattern": "^[0-9]+(Mi|Gi)$"}
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "timezone", "localTime", "dailyRetentionDays", "monthlyAnchorRetentionDays", "runRetentionDays", "softDeleteDays"],
      "properties": {
        "schedule": {"const": "15 23 * * *"},
        "timezone": {"type": "string", "minLength": 1},
        "localTime": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
        "dailyRetentionDays": {"type": "integer", "minimum": 1},
        "monthlyAnchorRetentionDays": {"type": "integer", "minimum": 365},
        "runRetentionDays": {"type": "integer", "minimum": 1},
        "softDeleteDays": {"type": "integer", "minimum": 1, "maximum": 365}
      }
    },
    "frontendAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "unauthenticatedClientAction", "clientIdEnvironmentVariable", "clientSecretEnvironmentVariable"],
      "properties": {
        "enabled": {"const": true},
        "unauthenticatedClientAction": {"const": "RedirectToLoginPage"},
        "clientIdEnvironmentVariable": {"$ref": "#/$defs/envName"},
        "clientSecretEnvironmentVariable": {"$ref": "#/$defs/envName"}
      }
    },
    "optionalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["telegramBotTokenEnvironmentVariable", "telegramChatIdEnvironmentVariable"],
      "properties": {
        "telegramBotTokenEnvironmentVariable": {"$ref": "#/$defs/envName"},
        "telegramChatIdEnvironmentVariable": {"$ref": "#/$defs/envName"}
      }
    },
    "diagnostics": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"const": true}}},
    "locks": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"const": true}}},
    "providers": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "prefixItems": [
        {"const": "Microsoft.App"},
        {"const": "Microsoft.DocumentDB"},
        {"const": "Microsoft.CognitiveServices"},
        {"const": "Microsoft.Storage"},
        {"const": "Microsoft.ManagedIdentity"},
        {"const": "Microsoft.OperationalInsights"},
        {"const": "Microsoft.Insights"},
        {"const": "Microsoft.Authorization"}
      ],
      "items": false
    }
  },
  "$defs": {
    "azureName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-]{1,62}$"},
    "containerAppName": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$"},
    "envName": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "immutableGhcrImage": {"type": "string", "pattern": "^ghcr\\.io/[a-z0-9._-]+/[a-z0-9._/-]+(?::sha-[0-9a-fA-F]{7,40}|@sha256:[0-9a-fA-F]{64})$"},
    "deploymentName": {"enum": ["gpt-5.4-mini", "gpt-5.6-luna", "gpt-5.6-sol"]},
    "modelMini": {"$ref": "#/$defs/modelBase", "unevaluatedProperties": false, "properties": {"deploymentName": {"const": "gpt-5.4-mini"}, "model": {"const": "gpt-5.4-mini"}, "version": {"const": "2026-03-17"}, "sku": {"const": "GlobalStandard"}, "capacity": {"type": "integer", "minimum": 1}}},
    "modelLuna": {"$ref": "#/$defs/modelBase", "unevaluatedProperties": false, "properties": {"deploymentName": {"const": "gpt-5.6-luna"}, "model": {"const": "gpt-5.6-luna"}, "version": {"const": "2026-07-09"}, "sku": {"const": "GlobalStandard"}, "capacity": {"type": "integer", "minimum": 1}}},
    "modelSol": {"$ref": "#/$defs/modelBase", "unevaluatedProperties": false, "properties": {"deploymentName": {"const": "gpt-5.6-sol"}, "model": {"const": "gpt-5.6-sol"}, "version": {"const": "2026-07-09"}, "sku": {"const": "GlobalStandard"}, "capacity": {"type": "integer", "minimum": 1}}},
    "modelBase": {"type": "object", "required": ["deploymentName", "model", "version", "sku", "capacity"], "properties": {"deploymentName": {}, "model": {}, "version": {}, "sku": {}, "capacity": {}}},
    "containerBase": {"type": "object", "required": ["name", "partitionKey", "ttl", "indexing"], "properties": {"name": {}, "partitionKey": {}, "ttl": {}, "indexing": {}}},
    "containerSymbols": {"$ref": "#/$defs/containerBase", "unevaluatedProperties": false, "properties": {"name": {"const": "symbols"}, "partitionKey": {"const": "/symbol"}, "ttl": {"type": "null"}, "indexing": {"const": "symbols"}}},
    "containerTelemetry": {"$ref": "#/$defs/containerBase", "unevaluatedProperties": false, "properties": {"name": {"const": "telemetry"}, "partitionKey": {"const": "/metric_type"}, "ttl": {"const": 2592000}, "indexing": {"const": "default"}}},
    "containerSettings": {"$ref": "#/$defs/containerBase", "unevaluatedProperties": false, "properties": {"name": {"const": "settings"}, "partitionKey": {"const": "/id"}, "ttl": {"type": "null"}, "indexing": {"const": "default"}}},
    "containerDgi": {"$ref": "#/$defs/containerBase", "unevaluatedProperties": false, "properties": {"name": {"const": "dgi_screener"}, "partitionKey": {"const": "/symbol"}, "ttl": {"type": "null"}, "indexing": {"const": "default"}}},
    "containerCalendar": {"$ref": "#/$defs/containerBase", "unevaluatedProperties": false, "properties": {"name": {"const": "calendar"}, "partitionKey": {"const": "/symbol"}, "ttl": {"type": "null"}, "indexing": {"const": "default"}}},
    "containerTraces": {"$ref": "#/$defs/containerBase", "unevaluatedProperties": false, "properties": {"name": {"const": "agent_traces"}, "partitionKey": {"const": "/symbol"}, "ttl": {"const": 7776000}, "indexing": {"const": "default"}}},
    "containerPortfolio": {"$ref": "#/$defs/containerBase", "unevaluatedProperties": false, "properties": {"name": {"const": "portfolio"}, "partitionKey": {"const": "/account_id"}, "ttl": {"type": "null"}, "indexing": {"const": "default"}}},
    "containerImports": {"$ref": "#/$defs/containerBase", "unevaluatedProperties": false, "properties": {"name": {"const": "import_sessions"}, "partitionKey": {"const": "/session_id"}, "ttl": {"const": -1}, "indexing": {"const": "default"}}},
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingress", "minReplicas", "maxReplicas", "cpu", "memory", "healthPath"],
      "properties": {
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["external", "targetPort"],
          "properties": {"external": {"const": false}, "targetPort": {"const": 8000}}
        },
        "minReplicas": {"const": 1},
        "maxReplicas": {"const": 1},
        "cpu": {"type": "number", "minimum": 0.25},
        "memory": {"type": "string", "pattern": "^[0-9]+(Mi|Gi)$"},
        "healthPath": {"const": "/healthz"}
      }
    }
  }
}
